rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Must match STAFF_EMAILS in js/firebase-config.js.
    function isStaff() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'gloria@glodiretech.com',
          'divinenamutaawe@gmail.com',
          'irenenairuba23@gmail.com'
        ];
    }

    function shortString(v, max) {
      return v is string && v.size() > 0 && v.size() <= max;
    }

    // Anyone can PLACE an order; only logged-in staff can see or change orders.
    match /orders/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'contact', 'service', 'message', 'status', 'createdAt'])
        && shortString(request.resource.data.name, 100)
        && shortString(request.resource.data.contact, 100)
        && shortString(request.resource.data.service, 60)
        && shortString(request.resource.data.message, 3000)
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isStaff();
    }

    // Everyone can SEE projects; only logged-in staff can add or remove them.
    match /projects/{id} {
      allow read: if true;
      allow write: if isStaff();
    }
  }
}
